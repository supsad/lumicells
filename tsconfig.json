{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "lumicells": ["./src/core/index.ts"],
      "lumicells/schema": ["./src/schema/index.ts"],
      "lumicells/react": ["./src/react/index.ts"],
      "lumicells/element": ["./src/element/index.ts"],
      "lumicells/element/define": ["./src/element/define.ts"]
    }
  },
  "include": ["src", "demo", "tests"]
}
