{
  "name": "pixel-life",
  "version": "0.1.0",
  "description": "Живой пиксельный фон на WebGL2: ядро без зависимостей, React-обёртка, Web Component и стенд настройки",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/lib/pixel-life.js",
  "module": "./dist/lib/pixel-life.js",
  "types": "./dist/types/core/index.d.ts",
  "unpkg": "./dist/lib/pixel-life-element.iife.js",
  "jsdelivr": "./dist/lib/pixel-life-element.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/lib/pixel-life.js",
      "default": "./dist/lib/pixel-life.js"
    },
    "./schema": {
      "types": "./dist/types/schema/index.d.ts",
      "import": "./dist/lib/pixel-life-schema.js",
      "default": "./dist/lib/pixel-life-schema.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/lib/pixel-life-react.js",
      "default": "./dist/lib/pixel-life-react.js"
    },
    "./element": {
      "types": "./dist/types/element/index.d.ts",
      "import": "./dist/lib/pixel-life-element.js",
      "default": "./dist/lib/pixel-life-element.js"
    },
    "./element/define": {
      "types": "./dist/types/element/define.d.ts",
      "import": "./dist/lib/pixel-life-element-define.js",
      "default": "./dist/lib/pixel-life-element-define.js"
    },
    "./schema.json": "./dist/lib/pixel-life.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib",
    "dist/types"
  ],
  "sideEffects": [
    "./src/element/define.ts",
    "./src/element/iife.ts",
    "./dist/lib/pixel-life-element-define.js",
    "./dist/lib/pixel-life-element.iife.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.element.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
